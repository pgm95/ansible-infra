# Managed by Ansible - network.dns role

[Resolve]
{% if net_dns_mode == 'static' %}
DNS={{ net_dns_servers | join(' ') }}
{% if net_dns_search | length > 0 %}
Domains={{ net_dns_search | join(' ') }}
{% endif %}
{% else %}
# Resolvers and search domains are deliberately absent: they come from the
# DHCP lease via systemd-networkd. Only local resolution behaviour is declared.
{% endif %}
DNSStubListener={{ 'yes' if net_dns_stub_resolver else 'no' }}
MulticastDNS={{ 'yes' if net_dns_mdns else 'no' }}
LLMNR={{ 'yes' if net_dns_llmnr else 'no' }}
